# ==============================================================================
# NetAI Wellness Platform - Variables de Entorno para Producción y Vercel
# ==============================================================================

# 1. Contraseña de Acceso Familiar Compartida (Zona B y PWA)
# Esta contraseña es la única que los miembros autorizados de la familia deben ingresar en /login
APP_FAMILY_PASSWORD="tu_clave_familiar_secreta_2026"

# 2. Clave secreta para la firma criptográfica HMAC-SHA256 de las cookies de sesión
# Podés generar una cadena aleatoria ejecutando en terminal: openssl rand -base64 32
SESSION_SECRET="generar_un_string_aleatorio_seguro_de_al_menos_32_caracteres"

# 3. Entorno de ejecución (development | production)
NODE_ENV="production"
