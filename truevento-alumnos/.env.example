# Same Supabase project as the management app (truevento-app). Public values.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Must be the same domain as the management app.
VITE_USERNAME_DOMAIN=truevento.com
# Optional: exact spot for the wind forecast (defaults to the coast of Itarema, Ceará)
# VITE_SPOT_LAT=-2.88
# VITE_SPOT_LON=-39.98
