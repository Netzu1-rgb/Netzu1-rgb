# Frontend (public: they are bundled into the app)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Logins created with a username become <username>@<this domain>. Must match USERNAME_DOMAIN.
VITE_USERNAME_DOMAIN=truevento.com
# Single-person mode (optional): with a password here there is NO login screen; the app
# signs in by itself. Anyone with the link can use it, so keep the link private.
# Choose any password (8+ characters). Leave empty to keep the normal login.
VITE_AUTO_LOGIN_PASSWORD=

# Server only (Vercel function /api/users). Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
USERNAME_DOMAIN=truevento.com

# Address of the students & instructors app (truevento-alumnos), used in invitations
VITE_STUDENTS_APP_URL=https://app.truevento.com

# Notifications on the phone (Web Push). Generate once: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
# Server only, secret:
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:truevento7@gmail.com
# Shared with the database (private.push_config.secret). openssl rand -hex 32
PUSH_SECRET=
SUPABASE_ANON_KEY=your-anon-or-publishable-key
